# Copy to .env.local for local development. Real values never go in git; on
# Vercel set them in Project Settings > Environment Variables.

# Server-only. Resend API key used by app/api/contact/route.ts to send
# contact-form inquiries to hello@drypointcreative.com.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Public (inlined into the client bundle at build time). Base URL the site's
# videos are served from, without a trailing slash. In production this is the
# Vercel Blob folder that mirrors ~/Movies/DRYPOINT-web/02_web, e.g.
#   https://<store-id>.public.blob.vercel-storage.com/work/v1
# Leave unset locally: the site then uses /_media, a git-ignored symlink to
# ~/Movies/DRYPOINT-web/02_web. Builds on Vercel fail without it (next.config.ts).
NEXT_PUBLIC_MEDIA_BASE_URL=
